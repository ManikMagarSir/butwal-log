# Server (0.0.0.0 = reachable on LAN; frontend+API only port published)
# PORT here is the CONTAINER port. Host port is set by the ports mapping in
# docker-compose.yml (currently 9090:3000). You do not need to change this.
HOST=0.0.0.0
PORT=3000
MONGO_URI=mongodb://mongo:27017/logbook
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# OTP mailer (Gmail + App Password)
SMTP_USER=your-id@timesglobal.com.np
SMTP_APP_PASS=xxxx-xxxx-xxxx-xxxx
SMTP_FROM=Butwal DC Logbook <your-id@timesglobal.com.np>
OTP_TTL_MIN=10

# Comma-separated emails auto-made admin on first OTP verify
ADMIN_EMAILS=admin@timesglobal.com.np

# Only this domain may register
ALLOWED_DOMAIN=timesglobal.com.np

# CORS: same-origin only by default (frontend is served by this server).
# Only set this if a separate frontend origin must call the API.
ALLOWED_ORIGINS=

# Set to true only behind HTTPS (Secure cookies are never sent over plain HTTP)
COOKIE_SECURE=false

# General API rate limit per IP per 15 min (auth OTP endpoints are stricter)
API_RATE_MAX=300
